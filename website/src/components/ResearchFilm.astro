---
import { Image } from "astro:assets";
import poster from "../assets/images/macro-epistemics-poster.png";
---

<div class="research-film" data-research-film>
  <div data-film-cover>
    <Image
      src={poster}
      alt="Macro-Epistemics: Make AI Answerable. An animated introduction to claims, evidence and correction."
      layout="constrained"
      widths={[480, 768, 1024, 1440]}
      sizes="(max-width: 48rem) calc(100vw - 2rem), 46rem"
      format="webp"
      loading="lazy"
      decoding="async"
      class="film-poster"
    />
    <a href="/media/macro-epistemics-draft-01.mp4" class="film-trigger" data-film-trigger aria-controls="research-film-video" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z" fill="currentColor" /></svg>
      <span>Watch the idea unfold <span class="film-runtime">1:58</span></span>
    </a>
  </div>
  <video id="research-film-video" data-film-video controls playsinline preload="none" hidden aria-label="Macro-Epistemics research film" tabindex="0">
    <track kind="captions" src="/media/macro-epistemics-draft-01.vtt" srclang="en" label="English" />
    Your browser cannot play this video. <a href="/media/macro-epistemics-draft-01.mp4">Download the film.</a>
  </video>
  <p class="film-status" role="status" data-film-status></p>
  <p class="film-fallback" data-film-fallback hidden>
    <a href="/media/macro-epistemics-draft-01.mp4" download>Download the film</a>,
    or use the play link above to try again.
  </p>
</div>

<script>
  const film = document.querySelector<HTMLElement>("[data-research-film]");
  const trigger = film?.querySelector<HTMLAnchorElement>("[data-film-trigger]");
  const cover = film?.querySelector<HTMLElement>("[data-film-cover]");
  const video = film?.querySelector<HTMLVideoElement>("[data-film-video]");
  const status = film?.querySelector<HTMLElement>("[data-film-status]");
  const fallback = film?.querySelector<HTMLElement>("[data-film-fallback]");

  if (film && trigger && cover && video && status && fallback) {
    video.addEventListener("loadeddata", () => {
      video.hidden = false;
      cover.hidden = true;
      film.setAttribute("aria-busy", "false");
      trigger.setAttribute("aria-expanded", "true");
      trigger.removeAttribute("aria-disabled");
      status.textContent = "";
      video.focus();
    });
    video.addEventListener("error", () => {
      video.hidden = true;
      cover.hidden = false;
      film.setAttribute("aria-busy", "false");
      trigger.setAttribute("aria-expanded", "false");
      trigger.removeAttribute("aria-disabled");
      video.removeAttribute("src");
      video.load();
      status.textContent = "The film could not load. You can try again or download it.";
      fallback.hidden = false;
    });
    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      if (trigger.getAttribute("aria-disabled") === "true") return;
      trigger.setAttribute("aria-disabled", "true");
      film.setAttribute("aria-busy", "true");
      status.textContent = "Loading the film…";
      fallback.hidden = true;
      video.src = trigger.href;
      video.play().catch(() => {
        if (video.error || !video.hasAttribute("src")) return;
        status.textContent = "Press play in the video controls, or use the film download below.";
      });
    });
  }
</script>

<style>
  .research-film { position: relative; border: 1px solid #d6d3d1; border-radius: 0.3rem; overflow: hidden; background: #f7f0de; }
  [data-film-cover] { position: relative; }
  .film-poster, video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  [hidden] { display: none !important; }
  .film-trigger { position: absolute; left: 50%; bottom: 8%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 0.65rem; width: max-content; max-width: 90%; padding: 0.65rem 1.1rem; border: 1px solid #193e32; border-radius: 999px; background: #193e32; color: #f7f0de; font-size: 0.85rem; line-height: 1.4; box-shadow: 0 3px 15px #193e321a; transition: background-color 150ms; }
  .film-trigger:hover { background: #24523f; }
  .film-trigger:focus-visible { outline: 3px solid #795b2b; outline-offset: 5px; }
  .film-trigger svg { width: 1.3rem; height: 1.3rem; flex-shrink: 0; }
  .film-runtime { display: block; opacity: 0.8; font-size: 0.68rem; }
  .film-status:empty { display: none; }
  .film-status { padding: 0.75rem 1rem; color: #193e32; font-size: 0.8rem; }
  .film-fallback { padding: 0 1rem 0.85rem; font-size: 0.8rem; }
  .film-fallback a { text-decoration: underline; text-underline-offset: 3px; }
</style>
