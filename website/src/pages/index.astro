---
import FindingsExplorer from "../components/FindingsExplorer.astro";
import ResearchLinks from "../components/ResearchLinks";
import { Separator } from "../components/ui/separator";
import research from "../data/research.json";
import "../styles/global.css";

const reportTitle = "Macro-Epistemics";
const reportType = "AI Safety Research · Epistemics";
const reportDate = "November 2026";
const authors = [
  { name: "Lucas Barbosa", affiliation: "NYU" },
  { name: "Stefan Gazzana", affiliation: "Roundarc" },
];
const description = "Can AI models distinguish a claim worth defending from one they should correct? Results from five models and 120 benchmark tasks.";
const codeUrl = "https://github.com/lbxa/macro-epistemics";
const paperUrl = "/files/confidence-correction-and-consensus.pdf";
const dataUrl = "https://huggingface.co/buckets/lbxa/macro-epistemics";
const artifactButtons = [
  // { label: "Explore results", href: "#explore" },
  { label: "Paper", href: paperUrl },
  { label: "Data", href: dataUrl },
  { label: "Code", href: codeUrl },
];
const resourceLinks = [
  { label: "Paper ↗", href: paperUrl },
  { label: "Data ↗", href: dataUrl },
  { label: "Data notes ↗", href: "/data/README.md" },
  { label: "Code ↗", href: codeUrl },
  { label: "About Veracity ↗", href: "https://veracity.lbxa.net/" },
];
---

<html lang="en" class="bg-background">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content="Macro-Epistemics · Make AI Answerable" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#fafaf9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=green-square" />
    <title>{reportTitle} · Make AI Answerable</title>
  </head>
  <body class="bg-background text-foreground">
    <a href="#idea" class="skip-link">Skip to the research</a>
    <main class="min-h-screen bg-background">
      <section class="mb-12 pt-8 md:pt-12">
        <div class="mx-auto max-w-3xl px-1">
          <header class="mb-12 pt-20">
              <div class="mb-14 flex flex-col gap-2 text-center text-xs">
                <svg viewBox="0 0 22 12" aria-hidden="true" class="mx-auto mb-4 block h-3 w-auto text-sm leading-none text-stone-800" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 1.5C3.51 1.5 1.5 3.51 1.5 6C1.5 8.49 3.51 10.5 6 10.5C8.2 10.5 9.98 8.95 11 7C12.02 8.95 13.8 10.5 16 10.5C18.49 10.5 20.5 8.49 20.5 6C20.5 3.51 18.49 1.5 16 1.5C13.8 1.5 12.02 3.05 11 5C9.98 3.05 8.2 1.5 6 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <p class="uppercase">{reportType}</p>
                <p>{reportDate}</p>
              </div>

              <Separator tone="ink" className="data-horizontal:h-1" />
              <h1 class="py-10 text-center text-4xl font-light tracking-tight [text-wrap:balance]">
                {reportTitle}
              </h1>
              <Separator tone="ink" className="data-horizontal:h-0.5" />
              <div class="mt-12 flex flex-wrap items-start justify-center gap-x-5 gap-y-4 text-center text-sm text-stone-600 md:mt-14">
                {
                  authors.map((author) => (
                    <span class="inline-flex flex-col items-center">
                      <span class="font-medium text-stone-900 underline underline-offset-4">{author.name}</span>
                      <span class="mt-1 text-stone-600">{author.affiliation}</span>
                    </span>
                  ))
                }
              </div>

              <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
                <ResearchLinks links={artifactButtons} variant="pill" size="compact" />
              </div>
          </header>
        </div>
      </section>

      <div class="research-content mx-auto max-w-3xl px-4 pb-20 md:px-1">
        <section id="idea" class="research-intro" aria-label="Research summary">
          <p>Can AI models distinguish a claim worth defending from one they should correct? We tested five models on 120 benchmark tasks across finance, law, science and education. Each answer was saved, then challenged under four conditions with five repeated defence generations. <a href="https://veracity.lbxa.net/" target="_blank" rel="noopener noreferrer">Veracity</a>’s three-juror verdicts were checked separately against benchmark references. Across 11,620 executed branches, models rarely abandoned reference-matching answers—but also rarely repaired mismatches, which juries frequently upheld. The study separates confidence, willingness to defend and evidential accuracy, while exposing grading defects that can distort all three.</p>
        </section>

        <dl class="study-scope" aria-label="Completed study scope">
          <div><dt>Source cases</dt><dd>{research.summary.sourceGroups}</dd></div>
          <div><dt>Model families</dt><dd>{research.summary.modelCount}</dd></div>
          <div><dt>Task domains</dt><dd>{research.summary.domainCount}</dd></div>
          <div><dt>Valid defences</dt><dd>{research.summary.validDefences.toLocaleString("en-US")}</dd></div>
        </dl>

        <section id="explore" class="research-section">
          <FindingsExplorer />
          <p class="figure-note">{research.summary.branchesAssigned.toLocaleString("en-US")} assigned dispute branches · {research.summary.executed.toLocaleString("en-US")} executed · {research.summary.settledVerdicts.toLocaleString("en-US")} settled. “Valid” means a usable structured response; correctness is scored separately. Missing and failed outputs remain in completion counts.</p>
          <p class="figure-note">Post hoc source checks changed {research.summary.auditChangedGrades} initial grades; original grades remain visible. An offline decoding procedure recovered {research.benchmarkValidity.recoveredReferences}/{research.benchmarkValidity.numericOriginals} stored numerical references from misleading objections. The plotted primary run retains this leakage flaw. Model exploitation was not observed, and the proposed repair was not deployed in that run.</p>
        </section>

        <section id="resources" class="research-section resources-section">
          <h2>Work with the data.</h2>
          <nav class="resource-links" aria-label="Research resources">
            <ResearchLinks links={resourceLinks} variant="link" />
          </nav>
        </section>
      </div>
    </main>
  </body>
</html>
